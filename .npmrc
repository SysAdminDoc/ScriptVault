engine-strict=true

# Supply-chain hardening: never run dependency lifecycle scripts (preinstall /
# install / postinstall) during install. This closes the npm-worm lifecycle-
# payload vector (Shai-Hulud / Mini-Shai-Hulud, 2026 H2), where a compromised
# transitive package executes exfiltration/self-propagation code at install
# time. ScriptVault ships zero runtime dependencies, so nothing user-facing
# needs a build step; the only devDependency with a postinstall is esbuild
# (`node install.js`), whose Windows binary is provided by the
# `@esbuild/win32-x64` optional dependency and resolves at runtime without the
# script. If a future devDependency genuinely requires a build step, run it
# explicitly and document it here rather than re-enabling scripts globally.
#
# Publish-token discipline (out-of-band, enforced on the maintainer account):
# the CWS/AMO/npm publish credential is publish-only scope with 2FA/OIDC; it is
# never used for `npm install` and never stored in the repo or CI.
ignore-scripts=true

# Supply-chain hardening #2: never resolve a dependency version published less
# than 7 days ago. `ignore-scripts` above defeats install-time payloads; this
# defeats the other half of the same attack, where a compromised maintainer
# account publishes a malicious version and it is pulled into a lockfile within
# hours. The keyv / cacheable compromise on 2026-08-04 ("Mini Shai-Hulud",
# ~619M downloads/month across the affected packages) is the worked example: a
# seven-day quarantine would have expired the window before the bad versions
# could be resolved here.
#
# This does NOT affect `npm ci`, which installs exactly what package-lock.json
# already pins — verified, so an AMO reviewer rebuilding from the submitted
# source is unaffected. It only gates resolving a NEW version.
#
# Escape hatch, for an advisory-driven bump that cannot wait: pass the flag on
# that one command and say why in the commit, e.g.
#   npm install dompurify@3.4.13 --min-release-age=0
# Do not lower the value in this file to work around a single package.
min-release-age=7
